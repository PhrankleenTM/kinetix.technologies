{
  "_global": {
    "list": {
      "nav.labels": {
        "selector": [
          ".links a",
          ".mobile-menu a.ml",
          ".f-grid > div:nth-child(2) ul li a"
        ],
        "render": "navLinks"
      },
      "nav.cta": {
        "selector": [".btn-nav", ".mobile-menu a.btn"],
        "render": "ctaLabel"
      },
      "settings.social": { "selector": ".socials", "render": "socials" },
      "settings.email": {
        "selector": "a[href^=\"mailto:\"]",
        "render": "mailto"
      }
    },
    "text": {
      "settings.footerBlurb": ".f-grid > div:first-child .blurb",
      "settings.footerTagline": ".f-bottom > span:last-child",
      "settings.logoText": ".wordmark",
      "insights.newsletter.note": ".f-grid > div:nth-child(4) > .note:last-of-type",
      "ui.footerNewsletterNote": ".f-grid > div:nth-child(4) > .note:first-of-type"
    },
    "special": ["seo", "colors", "logo", "ui", "siteName", "companyFooter"]
  },
